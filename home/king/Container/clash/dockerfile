FROM debian-base:latest

ARG USER
ARG DEB
ARG PKG="libappindicator3-1"

USER root
WORKDIR /root

RUN --mount=type=bind,source=./distdir,target=/root/distdir \
    apt install -y /root/distdir/${DEB} \
    && apt install -y ${PKG} \
    && apt clean

USER ${USER}
WORKDIR /home/${USER}

CMD [ "clash-verge" ]
