www-client/firefox        -hwaccel -gmp-autoupdate -telemetry clang lto openh264 pulseaudio system-pipewire system-png
media-video/pipewire      sound-server extra ffmpeg bluetooth
media-sound/pulseaudio    -daemon
gui-wm/sway               -X filecaps man swaybar swaynag -tray wallpapers
dev-util/vulkan-tools     wayland -X cube
app-i18n/fcitx            -autostart -emoji
x11-misc/i3blocks         -contrib
net-misc/chrony           -* caps rtc cmdmon readline seccomp
media-libs/freetype       harfbuzz
dev-embedded/openocd      -* jlink usb
dev-debug/gdb             server multitarget source-highlight xml
app-emulation/qemu        qemu_softmmu_targets_arm  qemu_softmmu_targets_x86_64  qemu_user_targets_x86_64 vnc spice ssh usb fuse virtfs usbredir
