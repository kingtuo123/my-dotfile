FROM debian-base:latest

ARG DEB
ARG PKG="libnss3 libxt6t64"

USER root
WORKDIR /root

RUN --mount=type=bind,source=./distdir,target=/root/distdir \
    apt install -y /root/distdir/${DEB} \
    && apt install -y ${PKG} \
    && apt clean

USER debian
WORKDIR /home/debian

CMD [ "/opt/baidunetdisk/baidunetdisk", "--no-sandbox", "--enable-features=UseOzonePlatform", "--ozone-platform=wayland"  ]
